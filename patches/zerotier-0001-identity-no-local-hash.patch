 			_lastIdentityVerification[iph] = now;
 			return true;
@@ -314,7 +314,13 @@ class Node : public NetworkController::Sender {
 	uint32_t _expectingRepliesTo[ZT_EXPECTING_REPLIES_BUCKET_MASK1 + 1][ZT_EXPECTING_REPLIES_BUCKET_MASK2 + 1];
 
 	// Time of last identity verification indexed by InetAddress.rateGateHash() -- used in IncomingPacket::_doHELLO() via rateGateIdentityVerification()
+#ifdef ZT_NO_LOCAL_IDENTITY_VALIDATION
+	// Without the memory-hard check there is nothing expensive to gate; a small
+	// table keeps the collision-branch rate limit while saving 126 KB.
+	int64_t _lastIdentityVerification[256];
+#else
 	int64_t _lastIdentityVerification[16384];
+#endif
 
 	// Statistics about stuff happening
 	volatile ZT_NodeStatistics _stats;
