diff --git a/node/IncomingPacket.cpp b/node/IncomingPacket.cpp
index cf55537a5..15eddc65f 100644
--- a/node/IncomingPacket.cpp
+++ b/node/IncomingPacket.cpp
@@ -439,11 +439,13 @@ bool IncomingPacket::_doHELLO(const RuntimeEnvironment* RR, void* tPtr, const bo
 			return true;
 		}
 
+#ifndef ZT_NO_LOCAL_IDENTITY_VALIDATION
 		// Check rate limits
 		if (! RR->node->rateGateIdentityVerification(now, _path->address())) {
 			RR->t->incomingPacketDroppedHELLO(tPtr, _path, pid, fromAddress, "rate limit exceeded");
 			return true;
 		}
+#endif
 
 		// Check packet integrity and MAC (this is faster than locallyValidate() so do it first to filter out total crap)
 		SharedPtr<Peer> newPeer(new Peer(RR, RR->identity, id));
@@ -452,11 +454,23 @@ bool IncomingPacket::_doHELLO(const RuntimeEnvironment* RR, void* tPtr, const bo
 			return true;
 		}
 
+#ifdef ZT_NO_LOCAL_IDENTITY_VALIDATION
+		// The memory-hard address derivation check needs a 2 MB scratch buffer,
+		// which this build cannot afford. Instead of validating locally, ask an
+		// upstream (root) for the identity behind this address. OK(WHOIS) answers
+		// from upstreams are already trusted as-is and add the peer to the
+		// topology; the sender's next HELLO then takes the known-peer path above
+		// and is checked against the identity the root gave us.
+		RR->sw->requestWhois(tPtr, now, id.address());
+		RR->t->incomingPacketDroppedHELLO(tPtr, _path, pid, fromAddress, "identity not yet known, WHOIS sent");
+		return true;
+#else
 		// Check that identity's address is valid as per the derivation function
 		if (! id.locallyValidate()) {
 			RR->t->incomingPacketDroppedHELLO(tPtr, _path, pid, fromAddress, "invalid identity");
 			return true;
 		}
+#endif
 
 		peer = RR->topology->addPeer(tPtr, newPeer);
 
