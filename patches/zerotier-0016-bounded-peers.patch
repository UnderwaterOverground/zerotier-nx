+struct _PeerSummaries {
+	const RuntimeEnvironment* RR;
+	int64_t now;
+	Node::PeerSummary* out;
+	unsigned long max;
+	unsigned long kept;
+	unsigned long total;
+};
+
+// Topology::eachPeer copies its function object: the state is behind a pointer.
+struct _SummarizePeer {
+	_PeerSummaries* const s;
+	_SummarizePeer(_PeerSummaries* st) : s(st)
+	{
+	}
+
+	inline void operator()(Topology& t, const SharedPtr<Peer>& p)
+	{
+		++s->total;
+		const uint64_t address = p->address().toInt();
+		// Keep the max lowest addresses, in order.
+		unsigned long at = s->kept;
+		while ((at > 0) && (s->out[at - 1].address > address)) {
+			--at;
+		}
+		if (at >= s->max) {
+			return;
+		}
+		if (s->kept < s->max) {
+			++s->kept;
+		}
+		for (unsigned long k = s->kept - 1; k > at; --k) {
+			s->out[k] = s->out[k - 1];
+		}
+		Node::PeerSummary& o = s->out[at];
+		memset(&o, 0, sizeof(o));
+		o.address = address;
+		if (p->remoteVersionKnown()) {
+			o.versionMajor = (int16_t)p->remoteVersionMajor();
+			o.versionMinor = (int16_t)p->remoteVersionMinor();
+			o.versionRev = (int16_t)p->remoteVersionRevision();
+		}
+		else {
+			o.versionMajor = -1;
+			o.versionMinor = -1;
+			o.versionRev = -1;
+		}
+		const unsigned int latency = p->latency(s->now);
+		o.latency = (latency >= 0x7fff) ? (int16_t)-1 : (int16_t)latency;
+		o.role = (uint8_t)t.role(p->address());
+		const SharedPtr<Path> best(p->getAppropriatePath(s->now, false));
+		if ((best) && (best->address().ss_family == AF_INET)) {
+			o.ip4 = reinterpret_cast<const struct sockaddr_in*>(&(best->address()))->sin_addr.s_addr;
+			o.port = (uint16_t)best->address().port();
+			o.lastReceive = best->lastIn();
+		}
+	}
+};
+
+}	// anonymous namespace
+
+unsigned long Node::peerSummaries(PeerSummary* out, unsigned long max) const
+{
+	_PeerSummaries s;
+	s.RR = RR;
+	s.now = _now;
+	s.out = out;
+	s.max = max;
+	s.kept = 0;
+	s.total = 0;
+	RR->topology->eachPeer(_SummarizePeer(&s));
+	return s.total;
 }
 
