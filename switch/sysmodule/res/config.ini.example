# zerotier-nx settings. Entering the network in the ZeroTier overlay
# (Network) makes config.ini from this file; or copy it to config.ini and
# edit it. Only network= is needed. Other changes apply after a restart.
#
# The ZeroTier network to join: its 16-character ID, from my.zerotier.com or
# your own controller. The overlay sets this line and joins at once. The
# Switch's own ID (10 characters) is in the overlay and in sysmodule.log once
# it has started; authorize it in the controller.
network=0123456789abcdef
# The UDP port ZeroTier uses. By default one worked out from this Switch's
# ZeroTier ID (20000-65499, always the same), so it can't clash with a
# computer on the same network using ZeroTier's usual 9993. Set it only if
# you forward a port to the Switch.
# port=9993
# Names for addresses on the network, one line each: "host = name address".
# Apps can then use the name, and Moonlight finds its PC by it. ZeroTier
# itself has no device names.
# host = gaming-pc 10.147.17.5
# Which programs' sockets can reach the network: homebrew (default), off, or
# homebrew,sys-ftpd to also serve sys-ftpd on the console's ZeroTier address
# (restarts sys-ftpd once at boot; about 70 KB more memory).
# mitm=homebrew
# Home-screen forwarders are served automatically when their title ID doesn't
# start with 01 (most don't). List any that do (16 hex digits, up to 16,
# comma or space separated) to let them reach the network too. The tool that
# made the forwarder shows its ID, as do title managers such as DBI or
# Goldleaf. Ignored with mitm=off.
# mitm_titles=0500000000001234, 05ABCDEF00000000
# The host= names into Atmosphere's hosts file, so apps can use them (off:
# addresses only).
# hosts=on
# Named devices at private addresses (10.x, 172.16-31.x, 192.168.x, which is
# where ZeroTier networks usually are) get a stand-in in 100.127.0.0/16 with
# the same last two numbers, so Moonlight sends video packets that fit one
# ZeroTier datagram; homebrew connecting to it reaches the real address (off:
# name the real addresses).
# aliases=on
# Memory for the network's sockets, shared by all apps (KB, 128-384, default
# 320). TCP connections get smaller buffers as it fills, so about 17 fit at
# once by default; raise it only if apps report "no buffer space" (errno
# 105). It comes out of the sysmodule's fixed heap.
# overlay_budget_kb=320
# A 5-second "Connected. IP: ..." toast after each boot.
# connect_notice=on
# Ask GitHub for the latest release once per boot, 10 seconds after
# connecting, and show a toast if it's newer.
# update_check=on
# Send the log as UDP datagrams, one per line, to this address (an address on
# the ZeroTier network works from anywhere).
# log_udp=192.168.1.10:5514
